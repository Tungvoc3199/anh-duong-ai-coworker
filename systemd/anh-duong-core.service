[Unit]
Description=Anh Duong AI Coworker Core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thadc
Group=thadc
WorkingDirectory=/home/thadc/AIOS/releases/anh-duong-core/current
EnvironmentFile=/home/thadc/.config/anh-duong-core/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/thadc/AIOS/releases/anh-duong-core/current/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8790
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
